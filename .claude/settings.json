{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Bash(gh secret*)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh api*)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth switch*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git pull --rebase origin main)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git revert*)",
      "Bash(git push origin main)",
      "Bash(gh auth status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh variable get SITE_ADRESSE)"
    ]
  }
}
